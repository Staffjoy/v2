# Schedulerr modernization baseline environment
# Copy this file to `.env` for local development.

# Application
ENV=development
SCHEDULERR_PUBLIC_URL=http://localhost:8000

# Database
POSTGRES_USER=schedulerr
POSTGRES_PASSWORD=schedulerr
POSTGRES_DB=schedulerr
POSTGRES_PORT=5432
DATABASE_URL=postgres://schedulerr:schedulerr@localhost:5432/schedulerr?sslmode=disable

# Session/Auth
SESSION_SECRET=replace-with-a-long-random-secret
COOKIE_SECURE=false

# Observability
LOG_LEVEL=debug
SENTRY_DSN=

# Billing (Stripe)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=

# Optional local tooling
MAILHOG_SMTP_PORT=1025
MAILHOG_HTTP_PORT=8025
